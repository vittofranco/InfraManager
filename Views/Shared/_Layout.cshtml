<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InfraManager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/infra.css" asp-append-version="true" />
</head>


@* em vez de a animação do fundo começar do zero, ele descobre quantos segundos já passaram desde a primeira vez vai continuar dali *@
<script>
    document.addEventListener("DOMContentLoaded", function () { 
        const bg = document.querySelector(".bg-animado");                       // espera o html carregar

        const inicioSalvo = localStorage.getItem("bgAnimStart");                // localstorage é uma mini memória do navegador, guarda dados mesmo mudando de página

        if (inicioSalvo) {                                                      
            const tempoTotal = 15000;                                          
            const agora = Date.now();
            const decorrido = (agora - parseInt(inicioSalvo)) % tempoTotal;

            bg.style.animationDelay = `-${decorrido}ms`;
        } else {
            localStorage.setItem("bgAnimStart", Date.now());
        }
    });
</script>

<body>

    <div class="bg-animado"></div>

    @* wrapper principal: fundo gradiente + sidebar + conteúdo lado a lado *@
    <div class="app-wrapper">

        @*sidebar *@
        <aside class="sidebar">

            @* logo no topo da sidebar *@
            <div class="sidebar-logo">
                <span class="sidebar-logo-text">InfraManager</span>
            </div>

            @* links de navegação *@
            <nav class="sidebar-nav">
                <a asp-controller="Home"        asp-action="Index" class="sidebar-link">
                    <span class="sidebar-label d-flex align-items-center"><i class="bi bi-house me-2"></i> Início</span>
                </a>
                <a asp-controller="Equipamentos" asp-action="Index" class="sidebar-link">
                    <span class="sidebar-label d-flex align-items-center"><i class="bi bi-laptop me-2"></i> Equipamentos</span>
                </a>
                <a asp-controller="Tarefas"     asp-action="Index" class="sidebar-link">
                    <span class="sidebar-label d-flex align-items-center"><i class="bi bi-clipboard-check me-2"></i> Tarefas</span>
                </a>
                <a asp-controller="Guias"       asp-action="Index" class="sidebar-link">
                    <span class="sidebar-label d-flex align-items-center"><i class="bi bi-journal-bookmark me-2"></i>Guias</span>
                </a>
            </nav>

        </aside>

        @* área principal *@
        <div class="app-main">

            @* conteúdo de cada página é renderizado aqui *@
            <main class="app-content">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @* marca o link ativo na sidebar conforme a URL atual *@
    <script>
        // pega o caminho da URL atual
        const path = window.location.pathname.toLowerCase();

        // percorre todos os links da sidebar
        document.querySelectorAll('.sidebar-link').forEach(link => {
            const href = link.getAttribute('href')?.toLowerCase() ?? '';

            // marca como ativo se o href bate com o início do caminho atual
            // ex: /equipamentos bate com /equipamentos/create
            if (href !== '/' && path.startsWith(href)) {
                link.classList.add('active');
            } else if (href === '/' && path === '/') {
                link.classList.add('active');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
