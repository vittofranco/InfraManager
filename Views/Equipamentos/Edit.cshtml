@*
   Equipamentos/Edit.cshtml — formulário de edição
   Igual ao Create, mas os campos chegam preenchidos com
   os dados atuais do equipamento
*@

@model InfraManager.Models.Equipamento

@{
    ViewData["Title"] = "Editar Equipamento";
}

<div class="page-container form-container">

    <h2>Editar Equipamento</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        @* campo oculto com o Id — o controller precisa saber qual equipamento editar *@
        <input type="hidden" asp-for="Id" />

        @* patrimônio fica somente leitura na edição — não faz sentido trocar o número
           readonly impede o usuário de alterar, mas o valor ainda é enviado pelo form *@
        <div class="form-group">
            <label asp-for="Patrimonio">Patrimônio</label>
            <input asp-for="Patrimonio" class="form-input form-input-readonly" readonly />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Tipo">Tipo de Equipamento</label>
                <select asp-for="Tipo" class="form-input">
                    <option value="Computador">Computador</option>
                    <option value="Impressora">Impressora</option>
                    <option value="Monitor">Monitor</option>
                    <option value="Nobreak">Nobreak</option>
                    <option value="Outro">Outro</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Gravidade">Gravidade</label>
                <select asp-for="Gravidade" class="form-input">
                    <option value="Baixa">Baixa</option>
                    <option value="Média">Média</option>
                    <option value="Alta">Alta</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Localizacao">Setor</label>
            <select asp-for="Localizacao" class="form-input">
                <option value="Call Center">Call Center</option>
                <option value="T.I">T.I</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Descricao">Descrição do Problema</label>
            <textarea asp-for="Descricao" class="form-input" rows="4"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Responsavel">Responsável</label>
            <input asp-for="Responsavel" class="form-input" />
        </div>

        <div class="form-acoes">
            <button type="submit" class="add-item-btn">Salvar Alterações</button>
            <a asp-action="Index" class="btn-voltar">Cancelar</a>
        </div>
    </form>

</div>
